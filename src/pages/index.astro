---
import "../styles/global.css";

const name = "Shariar Abdullah Nafi";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>{name} — Portfolio</title>
		<meta
			name="description"
			content="Portfolio of Shariar Abdullah Nafi."
		/>

		<!-- Google Fonts for Fraunces and Plus Jakarta Sans -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body
		class="min-h-screen bg-canvas text-foreground flex flex-col justify-center selection:bg-stone-200 selection:text-stone-900"
	>
		<main class="w-full max-w-xl mx-auto px-6 sm:px-8 py-16 sm:py-24">
			<!-- Header / Greeting -->
			<header class="mb-6 sm:mb-8">
				<h1
					class="font-title text-2xl sm:text-[1.75rem] font-normal leading-[1.35] tracking-tight text-stone-800"
				>
					Hello there,<br />
					My name is {name}.<br />
					I'm an aspiring software engineer.
				</h1>
			</header>

			<!-- About -->
			<section
				class="space-y-3 sm:space-y-3.5 text-stone-700 text-base sm:text-lg leading-relaxed"
			>
				<p>I'm currently studying Computer Science.</p>
				<p>
					My focus is on backend engineering, distributed systems, and
					API design.
				</p>
				<p>
					In my free time, I enjoy solving algorithmic problems on <a
						href="https://codeforces.com/profile/uvwxz"
						target="_blank"
						rel="noopener noreferrer"
						class="text-stone-800 underline underline-offset-4 decoration-stone-300 hover:text-stone-950 hover:decoration-stone-500 transition-colors"
						>Codeforces</a
					>.
				</p>
			</section>

			<!-- Action Buttons -->
			<nav
				aria-label="Social links"
				class="mt-8 sm:mt-10 flex flex-wrap items-center gap-3"
			>
				<!-- LinkedIn Button -->
				<a
					href="https://www.linkedin.com/in/sa-nafi"
					target="_blank"
					rel="noopener noreferrer"
					class="group inline-flex items-center gap-2.5 px-5 py-2.5 rounded-full bg-stone-900 text-stone-50 text-sm font-medium hover:bg-stone-800 active:scale-[0.98] transition-all duration-150 shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900"
				>
					<svg
						class="w-4 h-4 fill-current transition-transform duration-150 group-hover:scale-110"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path
							d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451c.979 0 1.778-.773 1.778-1.729V1.73C24 .774 23.205 0 22.225 0z"
						></path>
					</svg>
					<span>LinkedIn</span>
				</a>

				<!-- GitHub Button -->
				<a
					href="https://github.com/sa-nafi"
					target="_blank"
					rel="noopener noreferrer"
					class="group inline-flex items-center gap-2.5 px-5 py-2.5 rounded-full bg-stone-100 text-stone-800 border border-stone-200/80 text-sm font-medium hover:bg-stone-200/80 hover:border-stone-300 hover:text-stone-900 active:scale-[0.98] transition-all duration-150 shadow-2xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-700"
				>
					<svg
						class="w-4 h-4 fill-current transition-transform duration-150 group-hover:scale-110"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path
							fill-rule="evenodd"
							clip-rule="evenodd"
							d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
						></path>
					</svg>
					<span>GitHub</span>
				</a>
			</nav>
		</main>
	</body>
</html>
