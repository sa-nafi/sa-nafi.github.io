---
import { site } from "../../config/site";
import Icon from "../icons/Icon.astro";
---

<section class="flex flex-col gap-6" aria-labelledby="hero-name">
  <div>
    <div
      class="mb-3 flex items-center gap-1.5 font-mono text-xs uppercase tracking-wide text-muted-foreground"
    >
      <Icon name="mappin" class="size-3.25" />
      <span>{site.location}</span>
    </div>
    <h1
      id="hero-name"
      class="text-4xl font-bold tracking-tight sm:text-5xl text-foreground"
    >
      {site.name}
    </h1>
    <p class="mt-3 text-lg text-muted-foreground">{site.role}</p>
  </div>

  <p class="max-w-[60ch] text-base leading-relaxed text-muted-foreground">
    I'm currently studying Computer Science. My focus is on backend engineering,
    distributed systems, and API design. In my free time, I enjoy solving
    algorithmic problems on <a
      href={site.socials.codeforces}
      target="_blank"
      rel="noopener noreferrer"
      class="text-foreground underline underline-offset-4 decoration-muted-foreground/50 hover:decoration-foreground transition-colors"
      >Codeforces</a
    >.
  </p>

  <div class="flex flex-wrap gap-2" aria-label="Social and Contact Profiles">
    <a
      href={site.socials.github}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 rounded-full border border-border bg-panel px-3 py-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors"
    >
      <Icon name="github" class="size-3.25" />
      GitHub
    </a>
    <a
      href={site.socials.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 rounded-full border border-border bg-panel px-3 py-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors"
    >
      <Icon name="linkedin" class="size-3.25" />
      LinkedIn
    </a>
    <a
      href={`mailto:${site.email}`}
      class="inline-flex items-center gap-1.5 rounded-full border border-border bg-panel px-3 py-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors"
    >
      <Icon name="mail" class="size-3.25" />
      Email
    </a>
  </div>

  <div class="flex flex-wrap gap-2.5 pt-1">
    <a
      href="/blog"
      class="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground hover:opacity-90 active:scale-[0.98] transition-all"
    >
      Read Blogs
      <Icon name="arrow-right" class="size-3.25" />
    </a>
    <a
      href={site.resume || undefined}
      target={site.resume ? "_blank" : undefined}
      rel={site.resume ? "noopener noreferrer" : undefined}
      class="inline-flex items-center rounded-lg border border-border bg-panel px-4 py-2.5 text-sm font-medium text-foreground hover:bg-panel-2 active:scale-[0.98] transition-all cursor-pointer"
    >
      View Resume
    </a>
  </div>
</section>
