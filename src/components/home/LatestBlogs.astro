---
import { getPublishedBlogPosts } from "../../lib/utils";
import PostCard from "../blog/PostCard.astro";
import Icon from "../icons/Icon.astro";

const posts = (await getPublishedBlogPosts()).slice(0, 3);
---

<section id="blogs" class="flex flex-col gap-5" aria-labelledby="blogs-title">
  <div class="flex items-baseline justify-between">
    <h2
      id="blogs-title"
      class="text-xl font-semibold tracking-tight text-foreground"
    >
      Latest Writing
    </h2>
    <a
      href="/blog"
      class="inline-flex items-center gap-1 font-mono text-xs uppercase tracking-wide text-muted-foreground hover:text-foreground transition-colors"
    >
      <span>All posts</span>
      <Icon name="arrow-right" class="size-3" />
    </a>
  </div>

  {
    posts.length === 0 ? (
      <p class="py-4 text-sm text-muted-foreground">No posts published yet.</p>
    ) : (
      <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    )
  }
</section>
