---
import { site } from "../../config/site";
import ThemeToggle from "./ThemeToggle.astro";

const pathname = Astro.url.pathname;
const currentPath = pathname.replace(/\/$/, "") || "/";

const NAV_ITEMS = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
];

// Extract initials for monogram
const initials =
  site.name
    .split(" ")
    .map((word) => word[0])
    .filter(Boolean)
    .slice(0, 2)
    .join("")
    .toUpperCase() || "SN";
---

<header
  class="sticky top-0 z-20 border-b border-border bg-background/80 backdrop-blur"
>
  <div class="mx-auto flex h-15 max-w-235 items-center gap-2 px-6">
    <a
      href="/"
      class="mr-auto flex items-center gap-2 text-sm font-semibold text-foreground hover:opacity-90 transition-opacity"
    >
      <span
        class="flex h-6 w-6 items-center justify-center rounded-md bg-primary font-mono text-xs text-primary-foreground"
      >
        {initials}
      </span>
      <span>{site.name}</span>
    </a>
    <nav class="flex items-center gap-1" aria-label="Main Navigation">
      {
        NAV_ITEMS.map((item) => {
          const active =
            item.href === "/"
              ? currentPath === "/"
              : currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class={
                active
                  ? "rounded-lg bg-panel-2 px-3 py-1.5 text-sm font-medium text-foreground transition-colors"
                  : "rounded-lg px-3 py-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors"
              }
              aria-current={active ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
    <ThemeToggle />
  </div>
</header>
